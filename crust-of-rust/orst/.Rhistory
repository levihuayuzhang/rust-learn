library(ggplot2)
install.packages("ggplot2")
library(ggpplot2)
library(ggplot2)
t <- read.table('values.data')
t
ggplot(t, aes(n, comparisons, colour= algorithm)) + geom_point() + geom_smooth()
t <- read.table('values.data', header=TRUE)
ggplot(t, aes(n, comparisons, colour= algorithm)) + geom_point() + geom_smooth()
